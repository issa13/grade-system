# انسخ هذا الملف إلى .env.local وضع القيم من لوحة Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# اختياري: إشعارات على التلفون (npm run vapid لإنشاء المفتاحين؛ الخاص يوضع في GitHub Secrets فقط)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
